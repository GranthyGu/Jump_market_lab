{
    "cmake.sourceDirectory": "${workspaceFolder}/src",
    "cmake.buildDirectory": "${workspaceFolder}/build/cmake",
    "cmake.configureSettings": {
        "MARKETLAB_BUILD_TESTS": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${workspaceFolder}/build/bin",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${workspaceFolder}/build/lib",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${workspaceFolder}/build/lib"
    }
}
